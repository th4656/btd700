# Sennheiser BTD 600 and BTD 700 Bluetooth USB Adapters
# Vendor: 0x3542 (Sennheiser / Sonova)
# BTD 600: PID 0x3000
# BTD 700: PID 0x3001

KERNEL=="hidraw*", ATTRS{idVendor}=="3542", ATTRS{idProduct}=="3000", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3542", ATTRS{idProduct}=="3001", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="3542", ATTRS{idProduct}=="3000", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="3542", ATTRS{idProduct}=="3001", MODE="0666", TAG+="uaccess"
